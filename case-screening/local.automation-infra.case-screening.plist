<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.automation-infra.case-screening</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH" exec bash "$HOME/mac-mini-ci/case-screening/current/scripts/case-screening-run.sh"</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>40</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/local.automation-infra.case-screening.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/local.automation-infra.case-screening.err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
